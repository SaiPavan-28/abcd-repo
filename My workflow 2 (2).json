    {
      "parameters": {
        "functionCode": "const today = new Date();\nconst upcomingItems = [];\n\nfor (const item of items) {\n  const dueDateStr = item.json['Due Date'];\n  if (!dueDateStr) continue;\n\n  const parts = dueDateStr.split('-'); // expecting YYYY-MM-DD\n  const dueDate = new Date(parts[0], parts[1] - 1, parts[2]);\n  const diffTime = dueDate - today;\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n  if (diffDays >= 0 && diffDays <= 2) {\n    item.json['ReminderMessage'] = `Hello! This is a reminder that your assignment '${item.json['Assignment']}' for '${item.json['Subject']}' is due on ${item.json['Due Date']}. Please complete it on time!`;\n    upcomingItems.push(item);\n  }\n}\n\nreturn upcomingItems;"
      },
